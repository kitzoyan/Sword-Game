{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ (MSVC, manual SDK)",
      "type": "shell",
      "command": "${workspaceFolder}\\compile.bat",
      "args": ["${file}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$msCompile"],
      "detail": "Compiles the active .cpp file to an .exe using cl.exe with explicit SDK paths."
    }
  ]
}
